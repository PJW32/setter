# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 에 있어 깃에 올라가지 않습니다)
#   PowerShell:  Copy-Item .env.example .env
# 값에 따옴표는 필요 없습니다. 확인:  python config.py

# [필수] Gemini API 키 - Agent Platform(Vertex) API용 키 (코드는 vertexai=True 로 호출)
GEMINI_API_KEY=

# [선택] ODsay LAB - 애플리케이션 > API Key (서버용). 무료 한도 하루 약 30건이라 교차 확인용
ODSAY_API_KEY=

# [선택] 공공데이터포털 - 마이페이지 > 개발계정의 일반 인증키 (Encoding, Decoding 어느 쪽이든 됨)
#   (실거래가·상가정보는 키 없이 파일로 받을 수 있어 MVP에는 없어도 됨)
DATA_GO_KR_SERVICE_KEY=

# [필수] 카카오 디벨로퍼스 - 내 애플리케이션 > 앱 키 > REST API 키 (카카오맵 사용 설정 ON 필요)
KAKAO_REST_API_KEY=
